# Python ingest — copy to apps/ingest/.env and fill in.

# Supabase (service-role — full write access)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Source base URLs (no auth required — public endpoints)
PAJ_BASE_URL=https://www.paj.gr.jp/english/statis
ESTAT_API_BASE_URL=https://api.e-stat.go.jp/rest/3.0/app
ESTAT_APP_ID=
CUSTOMS_BASE_URL=https://www.customs.go.jp/toukei
CME_BASE_URL=https://www.cmegroup.com
EIA_API_KEY=
OPEC_BASKET_URL=https://www.opec.org/opec_web/en/data_graphs/40.htm

# Sentry (Python SDK)
SENTRY_DSN=
